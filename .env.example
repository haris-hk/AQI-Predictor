# Copy to .env for local development. In CI these live in GitHub Encrypted
# Secrets; in the dashboard they live in Streamlit's secrets manager. Never
# commit real values.

# Feature store and model registry (free tier at app.hopsworks.ai)
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# Optional: ground-station cross-check (free token at aqicn.org/data-platform/token/)
AQICN_TOKEN=

# Optional alert channels. Configure at least one to receive alerts.
NTFY_TOPIC=
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
